layout {

    focus-ring {
        active-color   "#ffabed"
        inactive-color "#1e100e"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffabed"
        inactive-color "#1e100e"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffabed"
        inactive-color "#712b68"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffabed80"
    }
}

recent-windows {
    highlight {
        active-color "#ffabed"
        urgent-color "#ffb4ab"
    }
}
